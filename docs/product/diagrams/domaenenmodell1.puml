@startuml

class Nutzer {
  Name
  Passwort
  E-Mail
  Telefonnummer [0..1]
  Nutzerrolle
  Kontostatus
}

class Organisation {
  Name
}

class Organisationstyp {
  Name
  Beschreibung
}

class Gegenstandstyp {
  Name
  Beschreibung
}

class Gegenstand {
  Inventarnummer
  Beschreibung
  Zustand
  Verfügbarkeitsstatus
}

class Ausleihanfrage {
  Startdatum
  Enddatum
  Status
  Ablehnungsgrund [0..1]
}


class Ausleihe {
  Startdatum
  Enddatum
  Status
  Übergabetermin
  Rückgabedatum [0..1]
}

class Reservierung {
  Startdatum
  Enddatum
  Status
}

class Zustandsprotokoll {
  Typ
  Notiz
  Fotos [0..1]
}

class Benachrichtigung {
  Typ
  Inhalt
  Status
}

class AusleihHistorie {
  Ausleihdatum
  Rückgabedatum
  ZustandVorher
  ZustandNachher
}

class Standort {
  Name
  Beschreibung
}

class Kategorie {
  Name
  Beschreibung
}

class Nutzungsbedingungen {
  Text
  Version
}

Nutzer "1" --> "0..*" Ausleihanfrage : erstellt
Nutzer "1" --> "0..*" Ausleihe : tätigt
Nutzer "1" --> "0..*" Reservierung : tätigt / bekommt / hat
Organisation "1" --> "0..*" Nutzer : enthält
Organisation "1" --> "0..*" Gegenstandstyp : verwaltet
Gegenstandstyp "1" --> "0..*" Gegenstand : besteht aus
Gegenstandstyp "0..*" --> "1" Kategorie : gehört zu
Kategorie "1" --> "0..*" Gegenstandstyp : enthält
Gegenstand "1" --> "0..*" Reservierung : wird reserviert in
Gegenstand "1" --> "0..1" Ausleihe : wird ausgeliehen in
Ausleihanfrage "1" --> "0..1" Reservierung : führt zu
Reservierung "1" --> "0..1" Ausleihe : wird umgesetzt in
Ausleihe "1" --> "0..2" Zustandsprotokoll : dokumentiert
Ausleihe "1..*" --> "1" AusleihHistorie : wird dokumentiert in
Gegenstandstyp "0..*" --> "1" Kategorie : gehört zu
Gegenstand "1" --> "1" Standort : befindet sich in
Standort "0..*" --> "1" Gegenstand : enthält
Nutzer "1" --> "0..*" Benachrichtigung : erhält
Ausleihe "0..*" --> "0..1" Nutzungsbedingungen : akzeptiert
Organisation "1" --> "0..*" Organisationstyp : gehört zu

@enduml